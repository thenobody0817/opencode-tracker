{
  "schemaVersion": 1,
  "id": "io.github.thenobody0817.opencode-tracker",
  "name": "OpenCode Tracker",
  "version": "1.3.0",
  "author": "thenobody0817",
  "license": "MIT",
  "description": "Token and cost usage per OpenCode provider (DeepSeek, Zen, Go, Bedrock, ...) with EUR conversion, DeepSeek credit balance, per-app attribution, per-model daily breakdowns, and OpenCode Go limit windows.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OpenCode Tracker",
    "description": "Per-provider tokens and cost in EUR, DeepSeek credit balance, top apps, and Go limits.",
    "category": "AI",
    "aliases": [
      "opencode-tracker",
      "zen-usage",
      "provider-usage",
      "deepseek"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "weeklyBudgetDollars",
        "type": "integer",
        "label": "Weekly budget in USD (0 = off)",
        "min": 0,
        "max": 100000,
        "step": 1,
        "defaultValue": 0
      }
    ]
  }
}
